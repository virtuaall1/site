{
  // Настройки деплоя на Cloudflare.
  //
  // Без этого файла wrangler сам угадывает, что публиковать, и
  // угадывает плохо: он взял корень репозитория целиком и упёрся в
  // node_modules/workerd на 147 МБ («Asset too large»). Здесь прямо
  // сказано: публикуем только dist — то, что собрал build.js.
  //
  // _headers с заголовками безопасности лежит внутри dist и
  // подхватывается автоматически: Workers разбирает его сам и
  // наружу как файл не отдаёт.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "site",
  "compatibility_date": "2026-09-03",
  // Одна живая ручка на весь сайт: POST /api/lead принимает заявку
  // из формы и отправляет её в Telegram. Воркер просыпается только
  // там, где файла нет, — статику по-прежнему отдаёт платформа.
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },

  /* Свой домен. Прописан здесь, а не выставлен руками в панели:
     деплой сам привяжет его и сам выпустит сертификат, и это
     переживёт пересоздание воркера.

     custom_domain — не то же самое, что route. Route говорит «на
     этот адрес отвечает воркер», но DNS-запись к нему надо
     заводить отдельно. custom_domain делает и то, и другое.

     Условие одно: в зоне не должно остаться записей A, AAAA или
     CNAME на сам vrtll.dev — Cloudflare заводит свою и с чужой
     конфликтует. Записи MX и TXT (почта, SPF, DKIM) при этом
     трогать не нужно, они не мешают.

     www намеренно не добавлен: одну и ту же страницу по двум
     адресам поисковик считает дублем. Правильнее сделать в
     Cloudflare редирект www → корень. */
  "routes": [
    { "pattern": "vrtll.dev", "custom_domain": true }
  ],
  /* Куда слать заявки. Это не секрет — просто номер чата, — и
     держать его в конфиге удобнее: деплой выставит его сам, и не
     надо помнить, в каком из двух разделов панели он лежал.

     Токена бота здесь нет и быть не должно. Он задаётся в панели
     как Secret: Workers → site → Settings → Variables and Secrets.
     Секреты этот файл не трогает — они переживают деплой.

     Важно: wrangler считает "vars" единственным источником правды
     для обычных переменных. Всё, что задано в панели открытым
     текстом и не перечислено здесь, при следующем деплое пропадёт. */
  "vars": {
    "TG_CHAT_ID": "8955354391"
  },

  "observability": {
    "enabled": true
  }
}
